source 'https://rubygems.org'  # Change to https for security

# Core dependencies
gem 'jekyll', '~> 3.9.3'
gem "jekyll-gitlab-metadata"

# GitHub Pages compatibility gems
group :jekyll_plugins do
  gem 'github-pages'
  gem 'jekyll-feed'
  gem 'jekyll-seo-tag'
  gem 'jekyll-sitemap'
end

# Required for newer Ruby versions
gem 'webrick'